# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.env

# Jupyter
.ipynb_checkpoints/

# Docker
*.log
logs/

# Data (we will keep raw data out of git; use .gitkeep for empty dirs)
data/raw/*
data/staging/*
data/curated/*
data/profiling/*
!data/raw/.gitkeep
!data/staging/.gitkeep
!data/curated/.gitkeep
!data/profiling/.gitkeep

# Curated data
!data/curated/ra_master.parquet
!data/curated/ra_master_partitioned/
!data/curated/ra_master_partitioned/**

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Secrets
*.pem
*.key

# Atomic-write temp files
*.part
*.parquet.part
*.csv.part
*.json.part

# Scratch
data/_scratch/

# Large regenerable exports — ignore
outputs/ra_master.csv
outputs/ra_master.jsonl

# Keep the small graded metric
!outputs/format_comparison.json

# Public intermediate CA certificate for elibrary.judiciary.gov.ph.
# Not a secret — sourced from GlobalSign's public AIA endpoint and verified
# before commit (see certs/README.md). Allow it despite the *.pem rule.
!certs/gsgccr3evtlsca2025.pem