# PostgreSQL
POSTGRES_USER=ra_user
POSTGRES_PASSWORD=ra_password
POSTGRES_DB=ra_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://ra_user:ra_password@postgres/ra_db
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here

# Bettergov

BETTERGOV_PARQUET_URL=https://huggingface.co/datasets/bettergovph/gov-library/resolve/main/repacts.parquet
# Lawphil scraping
LAWPHIL_BASE_URL=https://lawphil.net/statutes/repacts/
LAWPHIL_SAMPLE_SIZE=200

# Paths
DATA_DIR=/opt/airflow/data